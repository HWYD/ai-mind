{
    "name": "ai-mind",
    "version": "0.4.8",
    "packageManager": "pnpm@10.34.0",
    "engines": {
        "node": ">=22.0.0 <23.0.0"
    },
    "main": "index.js",
    "scripts": {
        "preinstall": "node scripts/validate/validate-workspace-boundaries.mjs",
        "validate:workspace-boundaries": "node scripts/validate/validate-workspace-boundaries.mjs",
        "test:workspace-boundaries": "node --test scripts/validate/validate-workspace-boundaries.test.mjs",
        "dev": "turbo run dev build:watch --filter=ai-mind...",
        "dev:webapp": "pnpm --dir apps/webapp dev",
        "dev:pas": "pnpm --dir apps/project-assistant-service dev",
        "build": "turbo run build",
        "build:pas": "pnpm --dir apps/project-assistant-service build",
        "build:watch": "turbo run build:watch --filter=@ai-mind/*",
        "db:generate": "pnpm --filter @ai-mind/database db:generate",
        "db:validate": "pnpm --filter @ai-mind/database db:validate",
        "db:migrate:deploy": "pnpm --filter @ai-mind/database db:migrate:deploy",
        "db:checkpoint:setup": "pnpm --dir apps/webapp db:checkpoint:setup",
        "db:chat-memory:setup": "pnpm --dir apps/webapp db:chat-memory:setup",
        "db:user-memory:setup": "pnpm --dir apps/webapp db:user-memory:setup",
        "db:runtime-checkpoints:setup": "pnpm --dir apps/webapp db:runtime-checkpoints:setup",
        "db:setup:deploy": "pnpm db:migrate:deploy && pnpm db:runtime-checkpoints:setup",
        "start": "pnpm --dir apps/webapp start",
        "typecheck": "turbo run typecheck",
        "typecheck:pas": "pnpm --dir apps/project-assistant-service typecheck",
        "test": "turbo run test",
        "docker:local:build": "docker compose -f deploy/compose.local.yml build",
        "docker:local:up": "docker compose -f deploy/compose.local.yml up -d",
        "docker:local:down": "docker compose -f deploy/compose.local.yml down",
        "docker:local:logs": "docker compose -f deploy/compose.local.yml logs -f",
        "commit": "git-cz",
        "prepare": "husky",
        "lint": "turbo run lint",
        "lint:root": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:webapp": "pnpm --dir apps/webapp lint",
        "lint:webapp:fix": "pnpm --dir apps/webapp lint:fix",
        "lint:packages:fix": "pnpm -r --filter \"./packages/*\" lint:fix"
    },
    "keywords": [],
    "author": "hwy",
    "license": "MIT",
    "description": "",
    "config": {
        "commitizen": {
            "path": "node_modules/cz-git"
        }
    },
    "lint-staged": {
        "*.{md,json}": [
            "prettier --cache --write --no-error-on-unmatched-pattern"
        ],
        "*.{css,less}": [
            "prettier --cache --write"
        ],
        "*.{js,jsx}": [
            "eslint --fix",
            "prettier --cache --write"
        ],
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --cache --parser=typescript --write"
        ]
    },
    "pnpm": {
        "overrides": {
            "@types/node": "$@types/node"
        }
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "eslint": "9.39.1",
        "@eslint/js": "9.39.1",
        "eslint-config-next": "16.0.5",
        "typescript-eslint": "8.48.0",
        "eslint-plugin-react-refresh": "0.4.24",
        "eslint-plugin-react-hooks": "^7.0.1",
        "globals": "16.5.0",
        "typescript": "catalog:",
        "eslint-plugin-prettier": "5.5.4",
        "eslint-plugin-simple-import-sort": "12.1.1",
        "lint-staged": "16.2.7",
        "prettier": "3.7.3",
        "@commitlint/cli": "20.1.0",
        "@commitlint/config-conventional": "20.0.0",
        "commitizen": "4.3.1",
        "fast-glob": "3.3.3",
        "husky": "9.1.7",
        "cz-git": "1.10.1",
        "tsup": "8.3.5",
        "turbo": "2.2.3",
        "rimraf": "6.0.1",
        "npm-run-all2": "7.0.1"
    }
}
