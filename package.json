{
    "name": "@ai-mind/workspace",
    "version": "0.5.2",
    "packageManager": "pnpm@10.34.0",
    "engines": {
        "node": ">=22.0.0 <23.0.0"
    },
    "main": "index.js",
    "private": true,
    "scripts": {
        "dev": "pnpm dev:db && node scripts/dev/run-local-env.mjs pnpm exec turbo run dev --filter=@ai-mind/webapp --filter=@ai-mind/project-assistant-service",
        "dev:watch": "pnpm dev:db && node scripts/dev/run-local-env.mjs node scripts/dev/run-turbo-stack-watch.mjs",
        "dev:webapp:db": "pnpm dev:db && node scripts/dev/run-local-env.mjs pnpm exec turbo run dev --filter=@ai-mind/webapp",
        "dev:db": "node scripts/dev/prepare-local-postgres.mjs",
        "dev:db:logs": "docker compose -f deploy/compose.dev-postgres.yml logs -f postgres",
        "dev:db:down": "docker compose -f deploy/compose.dev-postgres.yml down",
        "dev:db:setup": "pnpm dev:db && node scripts/dev/setup-local-postgres.mjs",
        "dev:webapp": "pnpm --dir apps/webapp dev",
        "dev:desktop": "pnpm dev:db && node scripts/dev/run-local-env.mjs pnpm exec turbo run dev --filter=@ai-mind/webapp --filter=@ai-mind/desktop",
        "dev:pas": "pnpm --dir apps/project-assistant-service dev",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "test": "pnpm test:stable && pnpm test:integration",
        "build": "pnpm validate:workspace-boundaries && turbo run build",
        "lint:fix": "eslint . --fix",
        "test:stable": "pnpm validate:workspace-boundaries && pnpm validate:test-lanes && pnpm test:governance && turbo run test:stable --filter=@ai-mind/webapp --filter=@ai-mind/stream-core --filter=@ai-mind/project-assistant-service --filter=@ai-mind/desktop",
        "test:integration": "pnpm validate:workspace-boundaries && pnpm validate:integration-test-env && turbo run test:integration --filter=@ai-mind/webapp --filter=@ai-mind/database --filter=@ai-mind/desktop",
        "test:external": "pnpm validate:workspace-boundaries && turbo run test:external --filter=@ai-mind/webapp",
        "desktop:make:windows": "pnpm --filter @ai-mind/desktop make:windows",
        "desktop:preview:make": "pnpm --filter @ai-mind/desktop preview:make",
        "desktop:verify:artifact": "pnpm --filter @ai-mind/desktop verify:artifact",
        "validate:workspace-boundaries": "node scripts/validate/validate-workspace-boundaries.mjs",
        "validate:test-lanes": "node scripts/validate/validate-test-lanes.mjs",
        "validate:integration-test-env": "node scripts/validate/validate-integration-test-env.mjs",
        "test:governance": "node --test scripts/validate/*.test.mjs",
        "test:governance:boundaries": "node --test scripts/validate/validate-workspace-boundaries.test.mjs",
        "test:governance:integration-env": "node --test scripts/validate/validate-integration-test-env.test.mjs",
        "test:governance:lanes": "node --test scripts/validate/validate-test-lanes.test.mjs",
        "start": "pnpm --dir apps/webapp start",
        "db:setup:deploy": "pnpm --filter @ai-mind/database db:migrate:deploy && pnpm --dir apps/webapp db:runtime-checkpoints:setup",
        "docker:local:build": "docker compose -f deploy/compose.local.yml build",
        "docker:local:up": "docker compose -f deploy/compose.local.yml up -d",
        "docker:local:logs": "docker compose -f deploy/compose.local.yml logs -f",
        "docker:local:down": "docker compose -f deploy/compose.local.yml down",
        "commit": "git-cz",
        "preinstall": "node scripts/validate/validate-workspace-boundaries.mjs",
        "prepare": "husky"
    },
    "keywords": [],
    "author": "hwy",
    "license": "MIT",
    "description": "",
    "config": {
        "commitizen": {
            "path": "node_modules/cz-git"
        }
    },
    "lint-staged": {
        "*.{md,json}": [
            "prettier --cache --write --no-error-on-unmatched-pattern"
        ],
        "*.{css,less}": [
            "prettier --cache --write"
        ],
        "*.{js,jsx}": [
            "eslint --fix",
            "prettier --cache --write"
        ],
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --cache --parser=typescript --write"
        ]
    },
    "pnpm": {
        "overrides": {
            "@types/node": "$@types/node"
        }
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "eslint": "9.39.1",
        "@eslint/js": "9.39.1",
        "eslint-config-next": "16.0.5",
        "typescript-eslint": "8.48.0",
        "eslint-plugin-react-refresh": "0.4.24",
        "eslint-plugin-react-hooks": "^7.0.1",
        "globals": "16.5.0",
        "typescript": "catalog:",
        "eslint-plugin-prettier": "5.5.4",
        "eslint-plugin-simple-import-sort": "12.1.1",
        "lint-staged": "16.2.7",
        "prettier": "3.7.3",
        "@commitlint/cli": "20.1.0",
        "@commitlint/config-conventional": "20.0.0",
        "commitizen": "4.3.1",
        "fast-glob": "3.3.3",
        "husky": "9.1.7",
        "cz-git": "1.10.1",
        "turbo": "2.2.3"
    }
}
