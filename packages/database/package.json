{
    "name": "@ai-mind/database",
    "version": "0.4.10",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm db:generate",
        "db:generate": "prisma generate",
        "db:format": "prisma format",
        "db:validate": "prisma validate",
        "db:migrate:dev": "prisma migrate dev",
        "db:migrate:deploy": "prisma migrate deploy",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "pnpm run test:integration",
        "test:integration": "node ../../scripts/validate/validate-integration-test-env.mjs && vitest run tests/prisma.integration.test.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@prisma/adapter-pg": "7.8.0",
        "@prisma/client": "7.8.0",
        "prisma": "7.8.0"
    },
    "devDependencies": {
        "dotenv": "catalog:",
        "vitest": "catalog:"
    }
}
