          "fontFamily": "Geist",
          "fontSize": 11.5,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "TTBry",
          "name": "Zero Tool Note",
          "fill": "#777777",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "零 Tool 直答不创建空 Tool 行；只保留“已完成思考”标题、无箭头且不可点击，final_answer 使用 agent-text 流式渲染。",
