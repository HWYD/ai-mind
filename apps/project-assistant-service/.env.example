# AI Mind project-assistant-service 环境变量模板。
# 裸进程通过 Shell 环境变量注入，容器阶段由 Compose env file 注入；真实 Token 不要提交到仓库。

# 容器运行时可改成 0.0.0.0，本地裸进程默认保持 127.0.0.1。
PROJECT_ASSISTANT_SERVICE_HOST=127.0.0.1
PROJECT_ASSISTANT_SERVICE_PORT=8788

# 本地开发默认 Token；生产环境必须显式替换为安全随机值。
PROJECT_ASSISTANT_SERVICE_MCP_TOKEN=project-assistant-service-dev-token

# 容器运行时建议由 Compose 注入。
# TZ=Asia/Shanghai
