{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "esModuleInterop": true,
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "forge.config.ts", "vitest*.ts", "playwright.config.ts"],
    "exclude": ["node_modules", ".webpack", "out"]
}
