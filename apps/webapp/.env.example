# AI Mind Webapp 环境变量模板。
# 本机开发可参考本文件创建 .env.local；真实 API Key 不要提交到仓库。

# --- 受控 Tasklist Agent 运行时 ---
# Prisma 业务表与 LangGraph PostgresSaver 共用 PostgreSQL 实例，但各自管理自己的表。
# 后续 project-assistant-service 需要数据层时也复用同一个 DATABASE_URL，不为每个服务单独建库。
# 本机开发默认使用 5433，尽量避开常见本地 PostgreSQL 的 5432 端口冲突。
DATABASE_URL=postgresql://ai_mind:ai_mind@127.0.0.1:5433/ai_mind
# 生产环境必须替换为高强度随机值；数据库只保存 sessionId 的 HMAC，不保存原始 cookie。
AI_MIND_AGENT_RUN_SESSION_SECRET=replace-with-a-strong-random-secret
# 可选值：on 或 off；控制是否输出 Graph 事件。
AI_MIND_GRAPH_EVENTS=off
# 可选值：postgres、memory 或 off；production / demo 使用 postgres，memory 仅用于开发调试。
AI_MIND_GRAPH_CHECKPOINT=off
# 可选值：on 或 off；控制是否展示脱敏 Graph Debug 摘要。
AI_MIND_GRAPH_DEBUG_VIEW=off

# --- Tasklist Agent LangSmith 观测（可选） ---
# 仅作用于 /tasklist + @docs://versions/*.md；LangSmith 是外部观测层，不是 AgentRun / checkpoint 事实源。
# enabled 条件为 LANGSMITH_TRACING=true 且 LANGSMITH_API_KEY 非空；关闭或缺少 Key 时不影响 Tasklist Agent 主流程。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-mind-dev
# 自托管 LangSmith 或特殊 endpoint 场景可额外设置 LANGSMITH_ENDPOINT；默认不需要。

# --- 模型 Provider 运行时 ---
# 本地默认模型；线上 Demo 可改为 qwen/qwen3.6-flash 等已登记的云模型 ID。
AI_MIND_DEFAULT_MODEL_ID=ollama/qwen3-8b
# 逗号分隔的 Provider 白名单，可选值：ollama、deepseek、qwen。
AI_MIND_ALLOWED_PROVIDERS=ollama,deepseek,qwen
AI_MIND_OLLAMA_BASE_URL=http://127.0.0.1:11434

# 云端 Provider Key 只允许在服务端配置。请将 xxx 替换为自行申请的 Key。
# 敏感 Key 建议配置在操作系统用户环境变量或部署平台 Secret 中。
# AI_MIND_DEEPSEEK_API_KEY=xxx
AI_MIND_DEEPSEEK_BASE_URL=https://api.deepseek.com
# AI_MIND_QWEN_API_KEY=xxx
AI_MIND_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 模型请求限制 ---
# 单次模型调用超时时间，单位为毫秒。
AI_MIND_LLM_TIMEOUT_MS=60000
# 模型采样温度，允许范围为 0 到 2。
AI_MIND_LLM_TEMPERATURE=0.7
# 普通聊天最大输出 token 数。
AI_MIND_CHAT_MAX_OUTPUT_TOKENS=4096
# Tasklist Agent 最大输出 token 数。
AI_MIND_TASKLIST_MAX_OUTPUT_TOKENS=8192
# 单次请求及注入上下文允许的最大字符数。
AI_MIND_MAX_INPUT_CHARS=12000

# --- 轻量 Demo 限流 ---
# 可选值：on 或 off；默认开启，当前仅使用进程内存计数。
AI_MIND_RATE_LIMIT_ENABLED=on
# 普通聊天每日每个 IP 的请求上限。
AI_MIND_CHAT_DAILY_LIMIT_PER_IP=200
# 普通聊天每日每个 Session 的请求上限。
AI_MIND_CHAT_DAILY_LIMIT_PER_SESSION=100
# Tasklist 每日每个 IP 的请求上限。
AI_MIND_TASKLIST_DAILY_LIMIT_PER_IP=50
# Tasklist 每日每个 Session 的请求上限。
AI_MIND_TASKLIST_DAILY_LIMIT_PER_SESSION=20

# --- Remote MCP：project-assistant-service ---
# 容器内会通过 Compose service DNS 覆盖为 http://project-assistant-service:8788/mcp。
PROJECT_ASSISTANT_SERVICE_MCP_BASE_URL=http://127.0.0.1:8788/mcp
# 本地开发默认 Token；生产环境必须与 project-assistant-service 使用同一个安全随机值。
PROJECT_ASSISTANT_SERVICE_MCP_TOKEN=project-assistant-service-dev-token

# --- 生产 Cookie 边界 ---
# 本地 HTTP 默认 off，生产 HTTPS 设为 on。
AI_MIND_SESSION_COOKIE_SECURE=off

# --- 容器时区说明 ---
# Compose / Docker 运行时建议注入 TZ=Asia/Shanghai。
