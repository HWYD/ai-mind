{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": ["pnpm-lock.yaml", "pnpm-workspace.yaml", "eslint.config.js", "tsconfig*.json"],
    "globalEnv": ["CI", "NODE_ENV"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
            "env": ["AI_MIND_*", "DATABASE_URL", "NEXT_PUBLIC_*", "PROJECT_ASSISTANT_SERVICE_*"]
        },
        "typecheck": {
            "dependsOn": ["^build", "^typecheck"],
            "outputs": []
        },
        "test:stable": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "test:integration": {
            "dependsOn": ["^build"],
            "cache": false,
            "outputs": [],
            "env": ["AI_MIND_*", "DATABASE_URL", "PROJECT_ASSISTANT_SERVICE_*"],
            "passThroughEnv": ["DISPLAY"]
        },
        "make:windows": {
            "cache": false,
            "outputs": ["out/**"]
        },
        "preview:make": {
            "cache": false,
            "outputs": ["out/**"]
        },
        "verify:artifact": {
            "cache": false,
            "outputs": []
        },
        "test:external": {
            "cache": false,
            "outputs": [],
            "env": ["AI_MIND_RUN_EXTERNAL_TESTS", "AI_MIND_RUN_CLOUD_USAGE_SMOKE", "AI_MIND_RUN_CHAT_MEMORY_COMPACTION_SMOKE", "AI_MIND_*"]
        },
        "lint": {
            "outputs": []
        },
        "dev": {
            "cache": false,
            "dependsOn": ["^build"],
            "persistent": true,
            "env": ["AI_MIND_*", "DATABASE_URL", "NEXT_PUBLIC_*", "PROJECT_ASSISTANT_SERVICE_*"]
        },
        "@ai-mind/database#build": {
            "cache": false,
            "outputs": []
        },
        "@ai-mind/stream-core#build:watch:transpile": {
            "cache": false,
            "persistent": true,
            "outputs": []
        },
        "@ai-mind/stream-core#build:watch:types": {
            "cache": false,
            "persistent": true,
            "outputs": []
        },
        "@ai-mind/database#typecheck": {
            "dependsOn": ["build"],
            "outputs": []
        },
        "@ai-mind/database#test:integration": {
            "dependsOn": ["build"],
            "cache": false,
            "outputs": [],
            "env": ["DATABASE_URL"]
        },
        "@ai-mind/webapp#test:integration": {
            "dependsOn": ["^build"],
            "cache": false,
            "outputs": [],
            "env": ["AI_MIND_*", "DATABASE_URL", "PROJECT_ASSISTANT_SERVICE_*"]
        }
    }
}
