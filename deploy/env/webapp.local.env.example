# 复制为 deploy/env/webapp.local.env 后再填写真实值。
# Compose 会注入 TZ、Cookie Secure 和 project-assistant-service 的容器内地址。

# 本地 Docker Demo 推荐直接走云模型，避免额外依赖宿主机 Ollama。
AI_MIND_DEFAULT_MODEL_ID=qwen/qwen3.6-flash
AI_MIND_ALLOWED_PROVIDERS=qwen,deepseek

# PostgreSQL 业务表、LangGraph checkpoint 与未来 PAS 数据层共用同一个 database。
DATABASE_URL=postgresql://ai_mind:ai_mind@postgres:5432/ai_mind
AI_MIND_AGENT_RUN_SESSION_SECRET=replace-with-a-strong-local-random-secret
AI_MIND_GRAPH_CHECKPOINT=postgres

# 将 xxx 替换为你自己的 Key；真实 Key 不要提交到仓库。
# AI_MIND_QWEN_API_KEY=xxx
AI_MIND_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MIND_DEEPSEEK_API_KEY=xxx
AI_MIND_DEEPSEEK_BASE_URL=https://api.deepseek.com

# 必须与 deploy/env/project-assistant-service.local.env 中保持同一个随机值。
PROJECT_ASSISTANT_SERVICE_MCP_TOKEN=replace-with-the-same-random-token-as-pas

# 本地 Compose 可继续沿用轻量限流默认值。
AI_MIND_RATE_LIMIT_ENABLED=on
AI_MIND_CHAT_DAILY_LIMIT_PER_IP=200
AI_MIND_CHAT_DAILY_LIMIT_PER_SESSION=100
AI_MIND_TASKLIST_DAILY_LIMIT_PER_IP=50
AI_MIND_TASKLIST_DAILY_LIMIT_PER_SESSION=20
