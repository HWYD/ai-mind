# AI Mind project-assistant-service 生产环境变量模板
# 真实值只放服务器 /srv/ai-mind/env/project-assistant-service.production.env。
# GitHub Actions 不持有模型 API Key、MCP Token、SSL 私钥，也不会覆盖服务器真实 env。
# webapp 与 PAS 的 PROJECT_ASSISTANT_SERVICE_MCP_TOKEN 必须完全一致。

NODE_ENV=production
TZ=Asia/Shanghai
PROJECT_ASSISTANT_SERVICE_HOST=0.0.0.0
PROJECT_ASSISTANT_SERVICE_PORT=8788
PROJECT_ASSISTANT_SERVICE_MCP_TOKEN=replace-with-same-strong-random-token-as-webapp
