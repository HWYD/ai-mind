# AI Mind webapp 生产环境变量模板
# 真实值只放服务器 /srv/ai-mind/env/webapp.production.env。
# GitHub Actions 不持有模型 API Key、MCP Token、SSL 私钥，也不会覆盖服务器真实 env。
# webapp 与 PAS 的 PROJECT_ASSISTANT_SERVICE_MCP_TOKEN 必须完全一致。

NODE_ENV=production
TZ=Asia/Shanghai
AI_MIND_SESSION_COOKIE_SECURE=on

# 根据生产启用的 provider 与默认模型显式设置。
AI_MIND_DEFAULT_MODEL_ID=qwen/qwen3.6-flash
AI_MIND_ALLOWED_PROVIDERS=qwen,deepseek

PROJECT_ASSISTANT_SERVICE_MCP_BASE_URL=http://project-assistant-service:8788/mcp
PROJECT_ASSISTANT_SERVICE_MCP_TOKEN=replace-with-same-strong-random-token-as-pas

AI_MIND_QWEN_API_KEY=replace-with-server-secret
AI_MIND_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MIND_DEEPSEEK_API_KEY=replace-with-server-secret
AI_MIND_DEEPSEEK_BASE_URL=https://api.deepseek.com
