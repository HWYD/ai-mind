# AI Mind Webapp 生产环境变量模板
# 复制为 /srv/ai-mind/env/webapp.env，填写真实值后：
#   chmod 600 /srv/ai-mind/env/webapp.env
#
# 说明：本模板不包含任何真实 API Key 或 MCP Token。
# API Key 和 Token 由部署人员在服务器本地填写，不通过 GitHub Actions 分发。

# 默认模型 ID（必须填写，例如 qwen/qwen3.7-plus 或 deepseek/deepseek-chat）
AI_MIND_DEFAULT_MODEL_ID=CHANGE_ME

# 允许的 Provider 列表，逗号分隔。
# 注意：这里填的是底层 provider，不是模型 family 名称；deepseek/* 这类 family 可以在 catalog 中改走不同 provider。
AI_MIND_ALLOWED_PROVIDERS=qwen

# PostgreSQL 业务表与 durable checkpoint；未来 PAS 数据层也复用同一个 DATABASE_URL。
DATABASE_URL=CHANGE_ME
AI_MIND_AGENT_RUN_SESSION_SECRET=CHANGE_ME
AI_MIND_GRAPH_CHECKPOINT=postgres
# v0.4.3 chat memory 使用独立的 langgraph_chat_memory schema；执行 pnpm db:setup:deploy 时会与 Tasklist checkpoint 一起初始化。
AI_MIND_CHAT_MEMORY_CHECKPOINT=postgres

# UserMemory semantic retrieval 使用独立的火山引擎 Ark embedding 配置，不跟随聊天模型选择器。
# 当前 doubao-embedding-vision 配置使用 1024 维；真实 API Key 只保存在服务器环境变量中。
# AI_MIND_DOUBAO_API_KEY=CHANGE_ME
AI_MIND_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
AI_MIND_USER_MEMORY_EMBEDDING_DIMENSIONS=1024

# Qwen Provider 配置
AI_MIND_QWEN_API_KEY=CHANGE_ME
AI_MIND_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek Provider 配置（可选，仅在需要 DeepSeek 时填写）
# AI_MIND_DEEPSEEK_API_KEY=CHANGE_ME
# AI_MIND_DEEPSEEK_BASE_URL=https://api.deepseek.com

# MCP Token：必须与 project-assistant-service.env 中的 token 完全一致
# 生成方式：uuidgen 或 openssl rand -hex 32
PROJECT_ASSISTANT_SERVICE_MCP_TOKEN=CHANGE_ME

# 速率限制
AI_MIND_RATE_LIMIT_ENABLED=on
AI_MIND_CHAT_DAILY_LIMIT_PER_IP=200
AI_MIND_CHAT_DAILY_LIMIT_PER_SESSION=100
AI_MIND_TASKLIST_DAILY_LIMIT_PER_IP=50
AI_MIND_TASKLIST_DAILY_LIMIT_PER_SESSION=20
